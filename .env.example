# Copy to .env on the host (never commit .env). Market data, scans, paper
# trading and the dashboard need no API keys.

# Required: Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/bitunix_bot

# Master switch for placing orders. Must be exactly "true" or "false".
# Orders are sent only when this is true AND LIVE_DRY_RUN is false.
TRADING_ENABLED=false

# The Bitunix account (optional). Set these in Railway variables only, never
# in a file in the repository. Create the key with trading permission and
# NO withdrawal permission. With keys and trading off, the bot only reads
# the account (balance, positions, open orders) for the logs and dashboard.
# BITUNIX_API_KEY=
# BITUNIX_API_SECRET=             # BITUNIX_SECRET_KEY also works
# LIVE_DRY_RUN=true              # report orders instead of sending them
# LIVE_LEVERAGE=10               # upper bound; per coin: 10x large caps, 5x mid, 3x small
# LIVE_MARGIN_MODE=ISOLATION     # or CROSS

# Paper trading: simulated fills on live data every 15 minutes, in the
# database only. Never touches an account and needs no API keys.
PAPER_TRADING=false
# PAPER_EQUITY=10000
# PAPER_EXTRAS=10                # extras besides BTC/ETH/XRP, frozen per session

# Read-only web dashboard. Off unless a password (12+ characters) is set.
# Any username works in the browser prompt. Railway sets PORT.
# DASHBOARD_PASSWORD=
# PORT=8080

# Optional (defaults shown).
# TIMEFRAMES=1h,4h,1d
# UNIVERSE=all                   # core = BTC/ETH/XRP only
# MIN_QUOTE_VOLUME_24H=10000000  # USDT, for non-core symbols
# MAX_EXTRA_SYMBOLS=100
# HISTORY_BARS=120
# CLOSE_DELAY_MS=20000
# MAX_FUNDING_AGE_MS=7200000
# BITUNIX_BASE_URL=https://fapi.bitunix.com
