{
  "name": "bitunix-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bitunix USDT-perpetuals trading bot with an RRG rotation scanner.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx packages/worker/src/main.ts run",
    "scan": "tsx packages/worker/src/main.ts scan",
    "migrate": "tsx packages/worker/src/main.ts migrate",
    "account": "tsx packages/worker/src/main.ts account",
    "probe": "tsx packages/bitunix/src/probe-cli.ts",
    "backtest": "tsx packages/backtest/src/cli.ts",
    "tune": "tsx packages/backtest/src/tune.ts",
    "baseline": "tsx packages/backtest/src/baseline.ts",
    "audit": "tsx packages/backtest/src/audit.ts",
    "walkforward": "tsx packages/backtest/src/walkforward.ts",
    "score": "tsx packages/backtest/src/score/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "research": "tsx packages/backtest/src/research.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "tsx": "^4.23.15"
  }
}
